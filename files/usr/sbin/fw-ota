#!/bin/sh
# ============================================================
#  fw-ota — 从【内网 LAN 服务器】检查并升级 OpenWrt x86 固件
#
#  服务器: 192.168.2.130:8080（.223 本地构建产物）
#  清单:   $OTA_URL/latest.json
#          { "version": <epoch>, "file": "xxx.img.gz",
#            "size": <bytes>, "sha256": "...", "built": "...",
#            "upstream": "..." }
#
#  用法:
#    fw-ota check                  检查是否有新版本（只读）
#    fw-ota download               下载 + 校验 sha256，停在 ready
#    fw-ota install [keep|nokeep] [force]
#                                  刷写已就绪的固件
#                                    keep   = 保留配置（默认，不加 -n）
#                                    nokeep = 全新安装（sysupgrade -n）
#                                    force  = 跳过镜像格式自检
#    fw-ota start                  后台静默下载（供 LuCI 调用）
#    fw-ota progress               输出进度 JSON
#    fw-ota cancel                 取消下载并清理临时文件
#    fw-ota update [keep|nokeep]   命令行：下载 → 交互确认 → 刷写
#    fw-ota version                显示本地版本
# ============================================================
set -u

OTA_CONF="/etc/fw-ota.conf"
OTA_URL_DEFAULT="http://192.168.2.130:8080"
VERFILE="/etc/fw-version"
WORKDIR="/tmp/fw-ota"

log() { echo "[fw-ota] $*"; }

ota_url() {
    if [ -f "$OTA_CONF" ]; then
        . "$OTA_CONF" 2>/dev/null
        [ -n "${OTA_URL:-}" ] && { echo "$OTA_URL"; return; }
    fi
    echo "$OTA_URL_DEFAULT"
}

local_ver() {
    [ -f "$VERFILE" ] && cat "$VERFILE" 2>/dev/null || echo 0
}

fetch_url() {
    # $1=url  $2=输出文件（- 表示 stdout）
    if command -v uclient-fetch >/dev/null 2>&1; then
        if [ "$2" = "-" ]; then uclient-fetch -q -O - "$1" 2>/dev/null
        else uclient-fetch -q -O "$2" "$1" 2>/dev/null; fi
    elif command -v curl >/dev/null 2>&1; then
        if [ "$2" = "-" ]; then curl -fsSL --max-time 30 "$1" 2>/dev/null
        else curl -fsSL --max-time 900 -o "$2" "$1" 2>/dev/null; fi
    else
        if [ "$2" = "-" ]; then wget -q -O - "$1" 2>/dev/null
        else wget -q -O "$2" "$1" 2>/dev/null; fi
    fi
}

json_get() {
    # $1=json  $2=字段名（字符串值）
    echo "$1" | jsonfilter -e "@.$2" 2>/dev/null
}

filesize() { wc -c < "$1" 2>/dev/null | tr -d ' '; }

do_check() {
    base=$(ota_url)
    log "OTA 服务器: $base"
    manifest=$(fetch_url "$base/latest.json" -)
    if [ -z "$manifest" ]; then
        log "无法访问 $base/latest.json（检查 .223 是否在线 / HTTP 服务是否运行）"
        return 2
    fi

    rv=$(json_get "$manifest" version)
    [ -z "$rv" ] && { log "解析 latest.json 失败"; return 2; }

    built=$(json_get "$manifest" built)
    upstream=$(json_get "$manifest" upstream)
    fname=$(json_get "$manifest" file)
    lv=$(local_ver)

    log "本地版本: $lv"
    log "远端版本: $rv  ($built)"
    log "上游版本: $upstream"
    log "远端文件: $fname"

    if [ "$rv" -gt "$lv" ] 2>/dev/null; then
        log "=> 有新版本可用"
        return 0
    fi
    log "=> 已是最新"
    return 1
}

do_fetch() {
    mkdir -p "$WORKDIR"
    base=$(ota_url)
    manifest=$(fetch_url "$base/latest.json" -)
    if [ -z "$manifest" ]; then
        log "无法访问 $base/latest.json"
        echo "error" > "$WORKDIR/state"
        return 2
    fi

    rv=$(json_get "$manifest" version)
    fname=$(json_get "$manifest" file)
    sha=$(json_get "$manifest" sha256)
    size=$(json_get "$manifest" size)
    built=$(json_get "$manifest" built)
    upstream=$(json_get "$manifest" upstream)

    [ -z "$rv" ] || [ -z "$fname" ] && { log "latest.json 字段不全"; echo "error" > "$WORKDIR/state"; return 2; }

    lv=$(local_ver)
    if ! [ "$rv" -gt "$lv" ] 2>/dev/null; then
        log "已是最新（本地 $lv / 远端 $rv），无需升级"
        echo "latest" > "$WORKDIR/state"
        return 0
    fi

    log "目标版本: $rv  文件: $fname"
    fw="$WORKDIR/firmware.img.gz"
    echo "${size:-0}" > "$WORKDIR/total"
    echo "$rv" > "$WORKDIR/tag"
    echo "${sha:-}" > "$WORKDIR/sha"
    echo "${built:-}" > "$WORKDIR/built"
    echo "${upstream:-}" > "$WORKDIR/upstream"
    echo "downloading" > "$WORKDIR/state"
    rm -f "$fw" "$WORKDIR/mode"

    log "下载固件（内网）…"
    if ! fetch_url "$base/$fname" "$fw"; then
        echo "error" > "$WORKDIR/state"
        log "下载失败"
        return 4
    fi
    [ -s "$fw" ] || { echo "error" > "$WORKDIR/state"; log "下载结果为空"; return 4; }

    echo "verifying" > "$WORKDIR/state"
    if [ -n "$sha" ]; then
        actual=$(sha256sum "$fw" | awk '{print $1}')
        if [ "$sha" != "$actual" ]; then
            echo "error" > "$WORKDIR/state"
            log "sha256 校验失败！期望 $sha / 实际 $actual"
            rm -f "$fw"
            return 5
        fi
        log "sha256 校验通过"
    else
        log "警告: latest.json 无 sha256，跳过校验"
    fi

    echo "ready" > "$WORKDIR/state"
    log "下载并校验完成，等待确认刷写"
    return 0
}

# sysupgrade 是否支持 --test（用于刷写前的镜像格式自检）
image_test_supported() {
    sysupgrade --help 2>&1 | grep -q -- '--test'
}

# 镜像自检；失败时把 stderr 打到 stdout 供 UI 展示
image_check() {
    fw="$1"
    if ! image_test_supported; then
        log "当前 sysupgrade 不支持 --test，跳过镜像自检"
        return 0
    fi
    log "镜像自检中…"
    out=$(sysupgrade --test "$fw" 2>&1)
    rc=$?
    if [ $rc -ne 0 ]; then
        log "镜像自检失败（rc=$rc）"
        [ -n "$out" ] && echo "$out"
        return 1
    fi
    log "镜像自检通过"
    return 0
}

do_install() {
    # $1=keep|nokeep（默认 keep）  $2=force（非空则跳过自检）
    mode="${1:-keep}"
    force="${2:-}"
    case "$mode" in
        keep)   args="" ;;
        nokeep) args="-n" ;;
        *)      log "未知模式: $mode（应为 keep 或 nokeep）"; return 1 ;;
    esac

    fw="$WORKDIR/firmware.img.gz"
    st=""
    [ -f "$WORKDIR/state" ] && st=$(cat "$WORKDIR/state" 2>/dev/null)
    if [ "$st" != "ready" ]; then
        log "没有已就绪的固件（当前状态: ${st:-idle}），请先下载并校验"
        return 1
    fi
    [ -s "$fw" ] || { log "固件文件不存在，请重新下载"; echo "error" > "$WORKDIR/state"; return 1; }

    if [ "$force" != "force" ]; then
        if ! image_check "$fw"; then
            log "拒绝刷写：镜像自检未通过（如需强刷，请加 force 参数）"
            return 6
        fi
    else
        log "已指定 force，跳过镜像自检"
    fi

    echo "$mode" > "$WORKDIR/mode"
    if [ "$mode" = "nokeep" ]; then
        log "开始 sysupgrade（不保留配置：清除全部设置，恢复出厂），设备即将重启…"
    else
        log "开始 sysupgrade（保留配置），设备即将重启…"
    fi
    echo "installing" > "$WORKDIR/state"

    # 刷写前先落盘，避免 sysupgrade 过程中断电导致半写
    sync

    if [ -n "$args" ]; then
        sysupgrade "$args" "$fw"
    else
        sysupgrade "$fw"
    fi
}

do_cancel() {
    log "正在取消…"
    pkill -f "uclient-fetch.*fw-ota" 2>/dev/null
    pkill -f "curl.*fw-ota" 2>/dev/null
    pkill -f "fw-ota force" 2>/dev/null
    pkill -f "fw-ota download" 2>/dev/null
    sleep 1
    rm -rf "$WORKDIR"; mkdir -p "$WORKDIR"
    echo "idle" > "$WORKDIR/state"
    log "已取消并清理临时文件"
    return 0
}

do_update() {
    # $1=keep|nokeep（默认 keep）
    mode="${1:-keep}"
    do_fetch || return $?
    if [ "$(cat "$WORKDIR/state" 2>/dev/null)" = "latest" ]; then
        return 0
    fi

    tag=$(cat "$WORKDIR/tag" 2>/dev/null)
    printf "确认刷入版本 %s 并重启？[Y/n] " "$tag"
    read ans
    case "$ans" in
        n|N|no|NO) log "已取消"; rm -f "$WORKDIR/firmware.img.gz"; echo "idle" > "$WORKDIR/state"; return 0 ;;
    esac

    if [ "$mode" = "nokeep" ]; then
        printf "将【清除全部配置】恢复出厂设置，确认？[y/N] "
        read ans
        case "$ans" in
            y|Y|yes|YES) ;;
            *) log "已取消（未刷写）"; return 0 ;;
        esac
    fi

    do_install "$mode"
}

do_progress() {
    state="idle"; bytes=0; total=0; tag=""; sha=""; built=""; upstream=""; mode=""
    [ -f "$WORKDIR/state" ]    && state=$(cat "$WORKDIR/state" 2>/dev/null)
    [ -f "$WORKDIR/total" ]    && total=$(cat "$WORKDIR/total" 2>/dev/null)
    [ -f "$WORKDIR/tag" ]      && tag=$(cat "$WORKDIR/tag" 2>/dev/null)
    [ -f "$WORKDIR/sha" ]      && sha=$(cat "$WORKDIR/sha" 2>/dev/null)
    [ -f "$WORKDIR/built" ]    && built=$(cat "$WORKDIR/built" 2>/dev/null)
    [ -f "$WORKDIR/upstream" ] && upstream=$(cat "$WORKDIR/upstream" 2>/dev/null)
    [ -f "$WORKDIR/mode" ]     && mode=$(cat "$WORKDIR/mode" 2>/dev/null)
    [ -f "$WORKDIR/firmware.img.gz" ] && bytes=$(filesize "$WORKDIR/firmware.img.gz")

    running=0
    ps w 2>/dev/null | grep -q "[f]w-ota force"    && running=1
    ps w 2>/dev/null | grep -q "[f]w-ota update"   && running=1
    ps w 2>/dev/null | grep -q "[f]w-ota download" && running=1
    if [ "$running" = "0" ]; then
        case "$state" in
            downloading|verifying)
                if [ "$total" -gt 0 ] 2>/dev/null && [ "$bytes" -ge "$total" ] 2>/dev/null; then
                    state="ready"
                else
                    state="idle"
                fi
                ;;
        esac
    fi

    [ "$total" -gt 0 ] 2>/dev/null || total=0
    [ "$bytes" -gt 0 ] 2>/dev/null || bytes=0

    percent=0
    if [ "$total" -gt 0 ] 2>/dev/null; then
        percent=$((bytes * 100 / total))
        [ "$percent" -gt 100 ] && percent=100
    fi

    printf '{"state":"%s","bytes":%s,"total":%s,"percent":%s,"tag":"%s","sha":"%s","built":"%s","upstream":"%s","mode":"%s"}\n' \
        "$state" "$bytes" "$total" "$percent" "$tag" "$sha" "$built" "$upstream" "$mode"
}

do_start() {
    mkdir -p "$WORKDIR"
    echo "downloading" > "$WORKDIR/state"
    nohup /usr/sbin/fw-ota download > /var/log/fw-ota-update.log 2>&1 &
    echo "started"
}

case "${1:-check}" in
    check)    do_check; exit $? ;;
    update)   do_update "${2:-keep}"; exit $? ;;
    force)    do_update "${2:-keep}"; exit $? ;;
    download) do_fetch; exit $? ;;
    start)    do_start; exit 0 ;;
    install)  do_install "${2:-keep}" "${3:-}"; exit $? ;;
    cancel)   do_cancel; exit $? ;;
    progress) do_progress; exit 0 ;;
    version)  echo "本地版本: $(local_ver)"; exit 0 ;;
    *)        echo "用法: $0 {check|download|install [keep|nokeep] [force]|start|progress|cancel|update [keep|nokeep]|version}"; exit 1 ;;
esac
