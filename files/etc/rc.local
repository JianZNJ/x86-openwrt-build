# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# WRTBWMON-GUARD: 单实例启动（绕过 procd）
(
  sleep 25
  pidof wrtbwmon >/dev/null 2>&1 || \
    /usr/sbin/wrtbwmon -46 -f /tmp/usage.db -p /tmp/usage.htm -u /etc/wrtbwmon.user -d
  logger -t wrtbwmon-guard "started: $(pidof wrtbwmon | tr '\n' ' ')"
) >/dev/null 2>&1 &

# ADBLOCK-FALLBACK: 兜底。正常情况下 adblock-fast 已由 S96 启动，
# 这里只是防止它那次启动失败（例如首次开机还没有压缩缓存、网络又没就绪）。
(
  sleep 120
  if ! pidof adblock-fast >/dev/null 2>&1; then
    mkdir -p /mnt/data/adblock-cache
    /etc/init.d/adblock-fast start >/var/log/adblock-fast-boot.log 2>&1
    logger -t adblock-fallback "start rc=$? :: $(/etc/init.d/adblock-fast status 2>&1 | head -1)"
  fi
) >/dev/null 2>&1 &

exit 0
