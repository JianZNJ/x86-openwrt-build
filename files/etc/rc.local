# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# WRTBWMON-GUARD: 单实例启动（绕过 procd）
(
  sleep 25
  pidof wrtbwmon >/dev/null 2>&1 || \
    /usr/sbin/wrtbwmon -46 -f /tmp/usage.db -p /tmp/usage.htm -u /etc/wrtbwmon.user -d
  logger -t wrtbwmon-guard "started: $(pidof wrtbwmon | tr '\n' ' ')"
) >/dev/null 2>&1 &

# ADBLOCK-DELAY: 延迟到系统起来后再 start
# 原因：adblock-fast 的 init 会持有 rc.common 的 fd 1000 排他锁；开机早期网络没通，
# start 会卡很久，此时 procd 起的 dockerd 会继承该 fd → 永久持锁 →
# 任何 `adblock-fast enabled` 调用都会阻塞 → rpcd 单线程卡死 → LuCI Bad Gateway。
(
  sleep 90
  rm -f /etc/rc.d/S20adblock-fast        # 确保下次开机不在 S20 早启
  /etc/init.d/adblock-fast start >/var/log/adblock-fast-boot.log 2>&1
  rm -f /etc/rc.d/S20adblock-fast
  logger -t adblock-delay "start rc=$? :: $(/etc/init.d/adblock-fast status 2>&1 | head -1)"
) >/dev/null 2>&1 &

exit 0
