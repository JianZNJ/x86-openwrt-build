#!/bin/sh
# adblock-fast 属于次要任务：不在 /etc/init.d 的开机顺序里启动，
# 改为由 /etc/rc.local 延迟到网络就绪之后再起（见镜像里的 rc.local）。
#
# 同时收紧下载参数：adblock-fast 的清单下载是在持有 rc.common 的 procd 锁
# （flock）期间进行的，一旦某个源变成黑洞，锁会被长期占用；而 LuCI 加载
# 会调用 `adblock-fast enabled`，它要抢同一把锁 —— rpcd 是单线程，被阻塞后
# 所有 LuCI 请求都会超时（Bad Gateway）。
#   curl_retry        8 → 2   （最坏 9 次尝试变成 3 次）
#   download_max_time 180 → 60（单次下载硬超时）
# 最坏持锁时间从 ~27 分钟降到 ~3 分钟。
rm -f /etc/rc.d/S20adblock-fast
uci -q set adblock-fast.config.curl_retry='2'
uci -q set adblock-fast.config.download_max_time='60'
uci -q commit adblock-fast
exit 0
