#!/bin/sh
# qb / memos 只允许内网与 WireGuard 访问（nginx allow/deny），
# 因此内网解析必须指向 LAN IP，避免绕行公网出口。
uci -q del_list dhcp.@dnsmasq[0].address='/qb.cloudzj.net/192.168.2.1'
uci -q del_list dhcp.@dnsmasq[0].address='/memos.cloudzj.net/192.168.2.1'
uci add_list dhcp.@dnsmasq[0].address='/qb.cloudzj.net/192.168.2.1'
uci add_list dhcp.@dnsmasq[0].address='/memos.cloudzj.net/192.168.2.1'
uci commit dhcp
exit 0
